/* Import Varela Round font */
@import url("https://fonts.googleapis.com/css2?family=Varela+Round&display=swap");
body {
  font-family: "Varela Round", sans-serif;
  background-color: #1a1a1a;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
}
.container {
  text-align: center;
  position: relative;
}
h1 {
  color: #e1b62b;
  font-size: 36px;
  margin-bottom: 20px;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
}
#word-box {
  margin: 20px;
  font-size: 24px;
  position: relative;
  display: inline-block;
}
button {
  background-color: rgb(34, 34, 34);
  color: #e1b62b;
  font-size: 18px;
  padding: 15px 30px;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-family: "Varela Round", sans-serif;
  transition:
    background-color 0.3s ease,
    transform 0.3s ease,
    box-shadow 0.3s ease;
}
button:hover {
  background-color: #333;
  transform: translateY(-2px);
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
}
button:focus {
  outline: none;
}
#word-box span {
  font-size: 20px;
  transition:
    font-size 0.3s ease,
    transform 0.3s ease;
  display: inline-block;
  position: relative;
}
.current-word {
  transform: scale(1.1);
  font-size: 25px;
}
#underline {
  position: absolute;
  height: 4px;
  background-color: #e1b62b;
  border-radius: 10px;
  bottom: -6px;
  transition: all 0.3s ease;
  pointer-events: none;
  z-index: 1;
}
#stats-container {
  margin-top: -20px;
  display: flex;
  justify-content: center;
  gap: 20px;
  color: #e1b62b;
}
#stats-container p {
  font-size: 18px;
}
#stats {
  margin-top: 20px;
  font-size: 18px;
  color: #e1b62b;
}
